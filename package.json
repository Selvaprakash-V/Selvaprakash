{
  "name": "mern-portfolio",
  "version": "1.0.0",
  "description": "MERN Stack Portfolio Application",
  "main": "backend/server/server.js",
  "scripts": {
    "start": "node backend/server/server.js",
    "server": "nodemon backend/server/server.js",
    "client": "npm start --prefix frontend/client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd frontend/client && npm install",
    "seed": "node backend/server/seed.js"
  },
  "keywords": [
    "portfolio",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1"
  }
}
